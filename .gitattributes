# GitHub Linguist Overrides
# https://github.com/github/linguist/blob/master/docs/overrides.md

# Treat backtesting tearsheets as generated/vendored so they do NOT count toward repository language stats
backtest_results/** linguist-vendored
backtest_results/** linguist-generated
backtest_results/**/*.html linguist-generated=true
backtest_results/**/*.html -linguist-detectable

# Exclude static/generated HTML from language statistics so Python is recognized as the primary language
*.html -linguist-detectable
frontend/index.html -linguist-detectable

# Ensure Python is actively detected
*.py linguist-detectable=true
